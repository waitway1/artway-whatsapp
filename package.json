{
  "name": "artway-whatsapp",
  "version": "0.1.0",
  "description": "ArtwayWhatsapp multi-account desktop workspace",
  "author": "Artway",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:ui": "vite --host 127.0.0.1",
    "test": "node --test electron/**/*.test.cjs",
    "test:cdp": "node tests/cdp-smoke.cjs",
    "test:packaged": "npx playwright test tests/packaged.spec.cjs",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "pack:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.4",
    "lucide-react": "^0.548.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.artway.whatsapp",
    "productName": "ArtwayWhatsapp",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/artway-whatsapp.ico",
      "artifactName": "ArtwayWhatsapp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  }
}
